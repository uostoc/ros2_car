<?xml version="1.0"?>
<robot name="fishbot">
    <!-- Robot Footprint -->
  <link name="base_footprint"/>
  <!-- base link -->
  <link name="base_link">
        <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
                <box size="0.315 0.315 0.005"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 0.7" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.35 0.35 0.005"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.03 0.0 0.101" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.03" radius="0.049"/>
        </geometry>
          <material name="black">
            <color rgba="0.0 0.0 0.0 0.7" />
          </material>
      </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="left_wheel_link" />
      <origin xyz="0.102 0.148 -0.052" />
      <axis xyz="0 1 0" />
  </joint>

  <link name="right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.03" radius="0.049"/>
        </geometry>
          <material name="black">
            <color rgba="0.0 0.0 0.0 0.7" />
          </material>
      </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="right_wheel_link" />
      <origin xyz="0.102 -0.148 -0.052" />
      <axis xyz="0 1 0" />
  </joint>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
          <sphere radius="0.011"/>
      </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
    </visual>
  </link>
    
  <joint name="caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="caster_link" />
      <origin xyz="-0.15 0.0 -0.10" />
      <axis xyz="0 1 0" />
  </joint>

  <link name="dock_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
          <box size="0.035 0.1 0.132"/>
      </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
    </visual>
  </link>
    
  <joint name="dock_joint" type="fixed">
      <parent link="base_link" />
      <child link="dock_link" />
      <origin xyz="-0.15 0.0 -0.033" />
      <axis xyz="0 1 0" />
  </joint>

  <!-- laser link -->
  <link name="laser_frame">
        <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
                <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 0.075" />
      </material>
    </visual>
  </link>

  <!-- laser joint -->
  <joint name="laser_joint" type="fixed">
      <parent link="base_link" />
      <child link="laser_frame" />
      <origin xyz="-0.03 0.0 0.075" />
  </joint>

  <link name="imu_link">
        <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
                    <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <!-- imu joint -->
  <joint name="imu_joint" type="fixed">
      <parent link="base_link" />
      <child link="imu_link" />
      <origin xyz="0.04 0.0 0.048" />
  </joint>

</robot>
