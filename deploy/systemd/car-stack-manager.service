[Unit]
Description=ROS 2 vehicle stack manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ros
Group=dialout
EnvironmentFile=-/etc/ros2-car/vehicle.env
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /opt/ros2-car/ros2_qt6_ws/install/setup.bash && exec ros2 run car_stack_manager car_stack_manager --ros-args --params-file /etc/ros2-car/vehicle.yaml'
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
