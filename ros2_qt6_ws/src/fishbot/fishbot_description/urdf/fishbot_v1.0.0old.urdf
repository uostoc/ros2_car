<?xml version="1.0"?>
<robot name="fishbot">
    
    <!-- Robot Footprint -->
  <link name="base_footprint"/>



  <!-- base link -->
  <link name="base_link">
  	<visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
		<box size="0.375 0.223 0.025"/>
      </geometry>
      <material name="blue">
      	<color rgba="0.1 0.1 1.0 0.5" /> 
      </material>
    </visual>
  </link>
 
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.1015" rpy="0 0 0"/>
  </joint>

  <link name="base_link_l">
  	<visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
		<box size="0.245 0.051 0.025"/>
      </geometry>
      <material name="blue">
      	<color rgba="0.1 0.1 1.0 0.5" /> 
      </material>
    </visual>
  </link>
 
  <joint name="base_link_l_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_l"/>
    <origin xyz="-0.065 0.138 0.0" rpy="0 0 0"/>
  </joint>

  <link name="base_link_r">
  	<visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
		<box size="0.245 0.051 0.025"/>
      </geometry>
      <material name="blue">
      	<color rgba="0.1 0.1 1.0 0.5" /> 
      </material>
    </visual>
  </link>
 
  <joint name="base_link_r_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_r"/>
    <origin xyz="-0.065 -0.138 0.0" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.0625"/>
        </geometry>
          <material name="black">
            <color rgba="0.0 0.0 0.0 0.5" /> 
          </material>
      </visual>
  </link>
    
  <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="left_wheel_link" />
      <origin xyz="0.125 0.1415 -0.03888" />
      <axis xyz="0 1 0" />
  </joint>
  
  <link name="right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.0625"/>
        </geometry>
          <material name="black">
            <color rgba="0.0 0.0 0.0 0.5" /> 
          </material>
      </visual>
  </link>
    
  <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="right_wheel_link" />
      <origin xyz="0.125 -0.1415 -0.03888" />
      <axis xyz="0 1 0" />
  </joint>

  <link name="caster_link_l">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
          <sphere radius="0.050625"/>
      </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
    </visual>
  </link>
    
  <joint name="caster_joint_l" type="fixed">
      <parent link="base_link" />
      <child link="caster_link_l" />
      <origin xyz="-0.136875 0.125875 -0.05075" />
      <axis xyz="0 1 0" />
  </joint>

  <link name="caster_link_r">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079 0 0"/>
      <geometry>
          <sphere radius="0.050625"/>
      </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.5" /> 
        </material>
    </visual>
  </link>
    
  <joint name="caster_joint_r" type="fixed">
      <parent link="base_link" />
      <child link="caster_link_r" />
      <origin xyz="-0.136875 -0.125875 -0.05075" />
      <axis xyz="0 1 0" />
  </joint>

  <!-- laser link -->
  <link name="laser_frame">
  	<visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
		<cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="black">
      	<color rgba="0.0 0.0 0.0 0.5" /> 
      </material>
    </visual>
  </link>
    
  <!-- laser joint -->
  <joint name="laser_joint" type="fixed">
      <parent link="base_link" />
      <child link="laser_frame" />
      <origin xyz="0.07 0 0.0975" />
  </joint>

  <link name="imu_link">
  	<visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
		    <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
  </link>

  <!-- imu joint -->
  <joint name="imu_joint" type="fixed">
      <parent link="base_link" />
      <child link="imu_link" />
      <origin xyz="0.1475 0 0.0725" />
  </joint>

</robot>